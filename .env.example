# 默认只能绑定回环地址。若改为内网地址，必须同时将 AUTH_MODE 设为 token。
MATELAB_BRIDGE_DATA_DIR=D:\MatElabBridgeData
MATELAB_BRIDGE_HOST=127.0.0.1
MATELAB_BRIDGE_PORT=8765
MATELAB_BRIDGE_AUTH_MODE=none
# MATELAB_BRIDGE_MAX_MANIFEST_BYTES=2097152

# token 模式使用三种不同的本地权限令牌；不要提交真实值。
# MATELAB_BRIDGE_SUBMIT_TOKEN=
# MATELAB_BRIDGE_STATUS_TOKEN=
# MATELAB_BRIDGE_MAINTENANCE_TOKEN=

MATELAB_BRIDGE_MATELAB_URL=https://eln.iphy.ac.cn:61262
MATELAB_BRIDGE_SERVER_ID=main
MATELAB_BRIDGE_OWNER_ID=self
MATELAB_BRIDGE_EXPERIMENT_NOTEBOOK=自动实验记录
MATELAB_BRIDGE_ANALYSIS_NOTEBOOK=分析与推导
MATELAB_BRIDGE_NOTE_NOTEBOOK=工作进展
# Gate 0 后填写稳定的记录本 ID，供“远端成功但本地响应丢失”的恢复路径使用。
# MATELAB_BRIDGE_EXPERIMENT_NOTEBOOK_ID=1264
# MATELAB_BRIDGE_ANALYSIS_NOTEBOOK_ID=
# MATELAB_BRIDGE_NOTE_NOTEBOOK_ID=
MATELAB_BRIDGE_EXPERIMENT_TEMPLATE=matelab-auto-experiment/v1
MATELAB_BRIDGE_ANALYSIS_TEMPLATE=matelab-analysis-derivation/v1
MATELAB_BRIDGE_NOTE_TEMPLATE=matelab-work-progress/v1
