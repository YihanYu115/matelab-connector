{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matelab-bridge.local/schemas/sync-receipt.v1.schema.json",
  "title": "Sync Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["sync_id", "capture_id", "manifest_sha256", "state", "attempt", "created_at", "updated_at"],
  "properties": {
    "sync_id": {"type": "string"},
    "capture_id": {"type": "string"},
    "source_locator": {"type": ["string", "null"]},
    "source_hash": {"type": ["string", "null"]},
    "manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"},
    "matelab_ref": {"oneOf": [{"$ref": "matelab-ref.v1.schema.json"}, {"type": "null"}]},
    "state": {"enum": ["receiving", "validating", "accepted", "ready", "uploading_files", "creating_record", "populating_record", "verifying_export", "matelab_verified", "complete", "retry_wait", "auth_required", "needs_attention", "abandoned"]},
    "attempt": {"type": "integer", "minimum": 0},
    "last_error": {"type": ["object", "null"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}

