    "/v1/captures/recent": {
      "get": {
        "operationId": "recent_captures_v1_captures_recent_get",
        "parameters": [
          {
            "in": "query",
            "name": "actor_id",
            "required": true,
            "schema": {
              "maxLength": 255,
              "minLength": 1,
              "title": "Actor Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "producer_id",
            "required": true,
            "schema": {
              "maxLength": 255,
              "minLength": 1,
              "title": "Producer Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "within_minutes",
            "required": false,
            "schema": {
              "default": 120,
              "maximum": 1440,
              "minimum": 1,
              "title": "Within Minutes",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "x-bridge-token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Bridge-Token"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RecentCandidate"
                  },
                  "title": "Response Recent Captures V1 Captures Recent Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Recent Captures",
        "tags": [
          "captures"
        ]
      }
    },
