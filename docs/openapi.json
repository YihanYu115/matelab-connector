{
  "components": {
    "schemas": {
      "ArtifactReceipt": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "title": "Artifact Id",
            "type": "string"
          },
          "sha256": {
            "title": "Sha256",
            "type": "string"
          },
          "size": {
            "title": "Size",
            "type": "integer"
          },
          "state": {
            "const": "received",
            "default": "received",
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "artifact_id",
          "size",
          "sha256"
        ],
        "title": "ArtifactReceipt",
        "type": "object"
      },
      "CaptureAccepted": {
        "additionalProperties": false,
        "properties": {
          "capture_id": {
            "title": "Capture Id",
            "type": "string"
          },
          "duplicate": {
            "default": false,
            "title": "Duplicate",
            "type": "boolean"
          },
          "manifest_sha256": {
            "title": "Manifest Sha256",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/SyncState"
          },
          "sync_id": {
            "title": "Sync Id",
            "type": "string"
          }
        },
        "required": [
          "capture_id",
          "sync_id",
          "manifest_sha256",
          "state"
        ],
        "title": "CaptureAccepted",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MatelabRecordRef": {
        "additionalProperties": false,
        "properties": {
          "attachment_hashes": {
            "items": {
              "type": "string"
            },
            "title": "Attachment Hashes",
            "type": "array"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "export_sha256": {
            "pattern": "^sha256:[0-9a-fA-F]{64}$",
            "title": "Export Sha256",
            "type": "string"
          },
          "locked": {
            "title": "Locked",
            "type": "boolean"
          },
          "modified_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Modified At"
          },
          "mutable_source": {
            "default": true,
            "title": "Mutable Source",
            "type": "boolean"
          },
          "notebook_id": {
            "title": "Notebook Id",
            "type": "string"
          },
          "notebook_name_snapshot": {
            "title": "Notebook Name Snapshot",
            "type": "string"
          },
          "owner_id": {
            "title": "Owner Id",
            "type": "string"
          },
          "record_id": {
            "title": "Record Id",
            "type": "string"
          },
          "record_uid": {
            "title": "Record Uid",
            "type": "string"
          },
          "record_version": {
            "minimum": 1.0,
            "title": "Record Version",
            "type": "integer"
          },
          "server_id": {
            "title": "Server Id",
            "type": "string"
          },
          "signed": {
            "title": "Signed",
            "type": "boolean"
          }
        },
        "required": [
          "server_id",
          "owner_id",
          "notebook_id",
          "notebook_name_snapshot",
          "record_id",
          "record_uid",
          "record_version",
          "locked",
          "signed",
          "export_sha256"
        ],
        "title": "MatelabRecordRef",
        "type": "object"
      },
      "RecentCandidate": {
        "additionalProperties": false,
        "properties": {
          "actor_id": {
            "title": "Actor Id",
            "type": "string"
          },
          "capture_id": {
            "title": "Capture Id",
            "type": "string"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "producer_id": {
            "title": "Producer Id",
            "type": "string"
          }
        },
        "required": [
          "capture_id",
          "occurred_at",
          "actor_id",
          "producer_id"
        ],
        "title": "RecentCandidate",
        "type": "object"
      },
      "SyncReceipt": {
        "additionalProperties": false,
        "properties": {
          "attempt": {
            "title": "Attempt",
            "type": "integer"
          },
          "capture_id": {
            "title": "Capture Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "last_error": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error"
          },
          "manifest_sha256": {
            "title": "Manifest Sha256",
            "type": "string"
          },
          "matelab_ref": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MatelabRecordRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Hash"
          },
          "source_locator": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Locator"
          },
          "state": {
            "$ref": "#/components/schemas/SyncState"
          },
          "sync_id": {
            "title": "Sync Id",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "sync_id",
          "capture_id",
          "manifest_sha256",
          "state",
          "attempt",
          "created_at",
          "updated_at"
        ],
        "title": "SyncReceipt",
        "type": "object"
      },
      "SyncState": {
        "enum": [
          "receiving",
          "validating",
          "accepted",
          "ready",
          "uploading_files",
          "creating_record",
          "populating_record",
          "verifying_export",
          "matelab_verified",
          "complete",
          "retry_wait",
          "auth_required",
          "needs_attention",
          "abandoned"
        ],
        "title": "SyncState",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Durable local Capture Envelope submission gateway",
    "title": "MatElab Desktop Bridge",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
